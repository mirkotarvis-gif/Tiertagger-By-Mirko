{
  "schemaVersion": 1,
  "id": "tiertags",
  "version": "${version}",
     "name": "Mirko's TierTagger",
  "description": "Shows players' MCTiers, PvPTiers and SubTiers rankings on their nametag. Use /tiers <player> for a full profile.",
  "authors": ["mirkotarvis"],
  "license": "MPL-2.0",
  "icon": "assets/tiertags/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.tiertags.TierTags"
    ]
  },
  "mixins": [
    "tiertags.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
